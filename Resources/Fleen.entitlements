<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Sandbox on. Every entitlement below is here because something concrete needs
         it; there is nothing "just in case". -->
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!-- The user picks their .kdbx and key file through an open panel. Read-only:
         Fleen does not write KDBX files. -->
    <key>com.apple.security.files.user-selected.read-only</key>
    <true/>

    <!-- Security-scoped bookmarks, so the database reopens on the next launch without
         asking the user to find it again every time. -->
    <key>com.apple.security.files.bookmarks.app-scope</key>
    <true/>

    <!-- DELIBERATELY ABSENT, and each absence is enforced by the sandbox rather than
         by our own restraint:
           · network.client / .server   — Fleen makes no network connections
           · application-groups         — nothing outside this process reads its data
           · keychain-access-groups     — the biometric key is this app's alone
           · autofill-credential-provider — there is no extension any more
         Cross-process Accessibility (auto-type) is blocked by the sandbox outright,
         which is the intended state: Fleen never synthesises keystrokes. -->
</dict>
</plist>
