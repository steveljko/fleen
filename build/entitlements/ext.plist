<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!-- The entitlement that makes this a credential provider. Without it the
         extension will not appear in System Settings › Passwords at all. -->
    <key>com.apple.developer.authentication-services.autofill-credential-provider</key>
    <true/>

    <!-- Shared container holding the encrypted snapshot. -->
    <key>com.apple.security.application-groups</key>
    <array>
        <string>94WY2HW4JW.group.com.fleen.Fleen</string>
    </array>

    <!-- Shared Keychain, for the biometry-gated snapshot key. -->
    <key>keychain-access-groups</key>
    <array>
        <string>94WY2HW4JW.com.fleen.Fleen</string>
    </array>

    <!-- No network entitlement: the extension reads a local file and nothing else. -->
</dict>
</plist>
